# Скопируйте в .env и при необходимости измените значения

# Секрет для подписи JWT (в проде — длинная случайная строка)
JWT_SECRET=change-me-please-super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS: список origin'ов через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Сервер
HOST=0.0.0.0
PORT=8000
