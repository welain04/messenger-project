# Скопируйте в .env и при необходимости измените значения.
#
# Секции:
#   1) Общие настройки (development и production)
#   2) Production — обязательные переменные (APP_ENV=production)

# =============================================================================
# 1) Общие настройки
# =============================================================================

# Окружение: development | production | test
# В production включаются жёсткие проверки — см. секцию 2 ниже.
APP_ENV=development

# Тестовые эндпоинты /api/v1/_test/* (только для E2E). В production ДОЛЖНО быть
# false — иначе приложение не запустится.
ENABLE_TEST_ENDPOINTS=false

# Открытая регистрация (true) или invite-only (false -> 403 на /auth/register).
ALLOW_PUBLIC_REGISTRATION=true

# Security headers: в production включаются автоматически; в dev — только при true.
ENABLE_SECURITY_HEADERS=false

# Секрет для подписи JWT.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-please-super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# База данных (SQLite). Пусто -> backend/messenger.db
DATABASE_PATH=

# URL подключения для Alembic и будущего PostgreSQL (Этап 6B).
# Пусто -> SQLite по DATABASE_PATH. Пример Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/messenger
DATABASE_URL=

# CORS: список origin'ов фронтенда через запятую (не *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# За обратным прокси (nginx): доверие к X-Forwarded-For для rate limit по IP.
# ВКЛЮЧАЙТЕ только за доверенным прокси.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1

# Rate limiting (запросов в минуту на один IP). 0 -> лимит отключён.
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_MIN=5
RATE_LIMIT_SEARCH_PER_MIN=30
RATE_LIMIT_VERIFY_PER_MIN=10
RATE_LIMIT_FORGOT_PASSWORD_PER_MIN=3
RATE_LIMIT_RESET_PASSWORD_PER_MIN=10

# memory — один процесс; redis — заготовка для нескольких инстансов (нужен REDIS_URL).
RATE_LIMIT_BACKEND=memory
REDIS_URL=

# Публичный URL фронтенда (ссылки в письмах verify/reset)
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_RESEND_MAX_PER_DAY=5

PASSWORD_RESET_TTL_HOURS=1
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_PER_DAY=5

# SMTP: в development можно оставить пустым (письма в консоль).
# В production SMTP_HOST обязателен.
# Примеры (нужен «пароль для приложения», не пароль от аккаунта):
#   Gmail:   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587  SMTP_USE_SSL=false
#   Yandex:  SMTP_HOST=smtp.yandex.ru   SMTP_PORT=465  SMTP_USE_SSL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

HOST=0.0.0.0
PORT=8000

# Sentry (пусто -> отключено). DSN: Settings -> Project -> Client Keys.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Ключ для GET /health/sentry-test?key=... (пусто -> эндпоинт отключён).
SENTRY_DEBUG_KEY=

# Structured logging (JSON в stdout на Amvera).
LOG_LEVEL=INFO
LOG_JSON=true

# Файлы: local — только для dev; production требует yandex (или другой S3).
STORAGE_PROVIDER=local
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-central1
SIGNED_URL_TTL_SECONDS=120
AVATAR_MAX_BYTES=5242880
ATTACHMENT_MAX_BYTES=20971520
ALLOWED_AVATAR_MIMES=image/jpeg,image/png,image/webp
ALLOWED_ATTACHMENT_MIMES=image/jpeg,image/png,image/webp,image/gif,application/pdf,text/plain,application/zip
STAGING_TTL_HOURS=24
LOCAL_STORAGE_PATH=uploads
STORAGE_SERVE_BASE_URL=http://localhost:8000

# =============================================================================
# 2) Production — обязательные переменные (APP_ENV=production)
# =============================================================================
# При APP_ENV=production приложение НЕ запустится, если:
#   - JWT_SECRET — дефолтный или пустой (задайте длинный случайный ключ)
#   - ENABLE_TEST_ENDPOINTS=true
#   - SMTP_HOST пуст
#   - STORAGE_PROVIDER=local
#   - при STORAGE_PROVIDER=yandex не заданы S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY
#   - FRONTEND_BASE_URL или CORS_ORIGINS содержат localhost / 127.0.0.1
#
# В production также отключаются: /docs, /redoc, /openapi.json, /test
# Security headers (X-Frame-Options и др.) включаются автоматически.
#
# Политики безопасности (зашиты в код, настраиваются при необходимости):
#   - Пароль: мин. 8 символов, буква + цифра
#   - Мессенджер (чаты, сообщения, файлы) — только с подтверждённым email
#   - Access-токен проверяется по активной сессии (sid) — logout действует сразу
#   - ALLOW_PUBLIC_REGISTRATION=false — закрытая регистрация
#
# Пример production-фрагмента (подставьте свои значения, не коммитьте .env):
#
# APP_ENV=production
# JWT_SECRET=<сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(64))">
# ENABLE_TEST_ENDPOINTS=false
# CORS_ORIGINS=https://app.example.com
# FRONTEND_BASE_URL=https://app.example.com
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_COUNT=1
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_SSL=false
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=<пароль приложения>
# EMAIL_FROM=no-reply@example.com
# STORAGE_PROVIDER=yandex
# S3_BUCKET=my-messenger-bucket
# S3_ACCESS_KEY=<ключ>
# S3_SECRET_KEY=<секрет>
# S3_REGION=ru-central1
