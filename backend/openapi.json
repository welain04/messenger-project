              }
            ],
            "title": "Title"
          },
          "participant_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Participant Ids"
          },
          "created_by": {
            "type": "string",
            "format": "uuid",
            "title": "Created By"
          },
